---
import Layout from "../layouts/Layout.astro";
import notes from "../data/notes.json";

const repo = "https://github.com/awesomeAE/audio2midi";
const download = `${repo}/releases/latest/download/Audio2MIDI-macOS.pkg`;
const github = (
  '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>'
);
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v13m0 0-5-5m5 5 5-5M5 20h14"/></svg>';

const steps = [
  { n: "01", title: "Drop a song or record", text: "Put Audio2MIDI on an audio track. Drop a wav, aiff, flac, mp3 or ogg, or press Record and play the track." },
  { n: "02", title: "Transcribe on your Mac", text: "The MuScriptor engine runs on 127.0.0.1. It detects the instruments in the full mix and writes one MIDI part per instrument." },
  { n: "03", title: "Drag MIDI into your DAW", text: "Check the result in the piano roll and by ear, then drag All parts or a single instrument straight onto a track." },
];

const features = [
  { title: "Full mixes in, parts out", text: "Drop a finished song. Guitar, bass, drums, voice and more come back as separate MIDI files, plus one file with every part.", tag: "Per instrument" },
  { title: "Lands on your grid", text: "Every MIDI file carries the detected tempo and meter, so parts snap into the arrangement instead of drifting.", tag: "Tempo + meter" },
  { title: "Align to beats", text: "Snap every note to the detected beat grid, or leave it off to keep the performance exactly as played.", tag: "Quantize" },
  { title: "Check it by ear", text: "Preview through the track: one slider mixes the original audio with the MIDI. Click the piano roll to jump.", tag: "Preview" },
  { title: "Saved with your project", text: "The transcription is stored in the plugin state. Reopen the session and your parts are still there.", tag: "Recall" },
  { title: "Record straight from the track", text: "No bounce needed. Press Record, play the track in your DAW, and transcribe the take.", tag: "Record" },
];

const rows = [
  ["Cost", "Free download and local transcription. No subscription, no credits.", "Free download. Transcription uses account credits."],
  ["Usage allowance", "No credit balance or monthly quota. Limited by your hardware.", "2.5 credits per audio second. Free plan: 5,000 credits/month (about 33 minutes)."],
  ["Processing", "Local, on your computer", "Cloud, on Mirelo's servers"],
  ["Audio upload", "No audio sent to a cloud service", "Audio uploaded for transcription"],
  ["Internet", "Only for the first dependency and model downloads", "Required for transcription"],
  ["Account", "No Audio2MIDI account. Free Hugging Face account for model access.", "Mirelo account required"],
  ["Plugin source", "Open source, AGPL-3.0", "Commercial product"],
  ["DAW workflow", "File drop or recording, full mixes, per-instrument and combined MIDI", "File drop or recording, full mixes, per-instrument and combined MIDI"],
  ["Model", "Open MuScriptor research model", "Audio-to-MIDI Pro production model"],
];

const faqs = [
  { q: "Is it really free?", a: "Yes. The plugin is free and open source under AGPL-3.0, and transcription runs on your own computer, so there are no credits, plans or per-song fees. You supply the hardware, disk space and electricity." },
  { q: "Can I use the results commercially?", a: "The plugin code is AGPL-3.0. The MuScriptor model weights are licensed CC BY-NC 4.0, which is a non-commercial licence. Read the licence on Hugging Face and decide for your use case before you rely on it commercially." },
  { q: "Does my audio leave my computer?", a: "No. The plugin talks to the engine on 127.0.0.1:8722, on your machine. The internet is only needed once, to download the Python environment and the model weights." },
  { q: "Is it as accurate as Mirelo's Audio-to-MIDI Pro?", a: "We don't claim that. Audio2MIDI uses the open MuScriptor research model. Mirelo's cloud product uses its own production model. Try it on your material: it costs nothing." },
  { q: "Why do I need a Hugging Face account?", a: "The model weights are gated. Accept the licence on the MuScriptor model page once, run uvx hf auth login, and the plugin downloads the weights on the first transcription." },
  { q: "Which DAWs does it work in?", a: "Any macOS host that loads VST3 or Audio Units, such as Ableton Live, Logic Pro or FL Studio. There is also a standalone app. There is no AAX version, so Pro Tools is not supported." },
  { q: "What about Windows?", a: "It builds from source but is untested. On Windows the engine runs PyTorch on the CPU, the MIDI preview is silent, and the engine can outlive a crashed DAW." },
  { q: "Why does macOS block the installer?", a: "The release is not signed or notarized. Open System Settings, Privacy & Security, and click Open Anyway once. The installer needs no administrator password and installs into your user Library." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Audio2MIDI",
  applicationCategory: "MultimediaApplication",
  operatingSystem: "macOS 11+",
  description: "Free, local, open-source audio-to-MIDI plugin (VST3, AU, Standalone).",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  downloadUrl: download,
  license: "https://www.gnu.org/licenses/agpl-3.0.html",
  url: "https://awesomeae.com/",
};
---

<Layout
  title="Audio2MIDI · Free local audio-to-MIDI plugin"
  description="Turn full songs into MIDI, one part per instrument, right on your Mac. A free, open-source VST3 and AU plugin: no credits, no quota, no upload."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <header class="nav" id="nav">
    <div class="wrap nav-inner">
      <a class="brand" href="/" aria-label="awesomeAE home">
        <img src="/logo.png" alt="" width="34" height="34" />
        <span>awesome<b>AE</b></span>
      </a>
      <nav aria-label="Main">
        <a href="#how">How it works</a>
        <a href="#local">Local</a>
        <a href="#compare">Compare</a>
        <a href="#faq">FAQ</a>
      </nav>
      <div class="nav-cta">
        <a class="icon-link" href={repo} aria-label="Audio2MIDI on GitHub"><Fragment set:html={github} /></a>
        <a class="btn small" href={download}>Download</a>
      </div>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="wrap hero-copy">
        <span class="pill reveal"><span class="dot"></span>Runs on your machine · zero credits</span>
        <h1 class="reveal">Turn any song into MIDI.<br /><span class="grad-text">Right on your Mac.</span></h1>
        <p class="lead reveal">
          Audio2MIDI is a free VST3 and AU plugin that transcribes full mixes into one MIDI part per instrument. No credits to buy, no monthly quota, no upload. The only limit is your hardware.
        </p>
        <div class="cta reveal">
          <a class="btn" href={download}><Fragment set:html={arrow} />Download for macOS</a>
          <a class="btn ghost" href={repo}><Fragment set:html={github} />View source</a>
        </div>
        <p class="fine reveal">Free · macOS 11+ · Apple Silicon & Intel · VST3, AU, Standalone</p>
      </div>

      <div class="wrap">
        <div class="studio reveal" id="studio">
          <div class="studio-bar">
            <span class="lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="studio-title">Audio2MIDI</span>
            <span class="engine"><span class="dot"></span><span class="mono">engine · 127.0.0.1:8722</span></span>
          </div>
          <div class="studio-body">
            <div class="roll-wrap">
              <canvas id="wave" height="56" aria-hidden="true"></canvas>
              <canvas id="roll" height="300" tabindex="0" role="img" aria-label="Piano roll of a real Audio2MIDI transcription: guitar, bass and drums. Arrow keys move the playhead."></canvas>
            </div>
            <aside class="parts">
              <div class="parts-head">
                <span>Parts</span>
                <button class="play" id="play" type="button" data-on="false">
                  <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 4.5v15l13-7.5z"/></svg>
                  <svg class="i-stop" viewBox="0 0 24 24" aria-hidden="true"><rect fill="currentColor" x="6" y="6" width="12" height="12" rx="2"/></svg>
                  <span class="play-label">Hear it</span>
                </button>
              </div>
              <ul id="part-list" role="list"></ul>
              <p class="parts-note">Real transcription excerpt. Notes only, played by a tiny browser synth.</p>
            </aside>
          </div>
        </div>
      </div>
    </section>

    <section class="strip" aria-label="At a glance">
      <div class="wrap strip-grid">
        <div class="reveal"><b>0</b><span>credits per song</span></div>
        <div class="reveal"><b>0 MB</b><span>of audio uploaded</span></div>
        <div class="reveal"><b>3</b><span>model sizes to choose from</span></div>
        <div class="reveal"><b>AGPL</b><span>open-source plugin</span></div>
      </div>
    </section>

    <section class="section" id="how">
      <div class="wrap">
        <span class="eyebrow reveal">How it works</span>
        <h2 class="reveal">From full mix to editable MIDI<br />in three moves.</h2>
        <div class="steps">
          {steps.map((s) => (
            <article class="step reveal">
              <span class="step-n mono">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </article>
          ))}
        </div>
        <figure class="shot reveal">
          <img src="/plugin.png" alt="The Audio2MIDI plugin window with a transcribed song in the piano roll and four parts ready to drag" width="642" height="616" loading="lazy" />
          <figcaption>
            <h3>The whole workflow in one window.</h3>
            <p>Drop, transcribe, listen, drag. The parts list shows every detected instrument with its note count. Drag a row into your arrangement, or open the MIDI files with Show files.</p>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="section dark" id="local">
      <div class="wrap">
        <span class="eyebrow reveal">Local by design</span>
        <h2 class="reveal">Your studio is the server.<br /><span class="grad-text">The meter never runs.</span></h2>
        <p class="lead reveal">Cloud transcription bills by the second of audio. Audio2MIDI runs the model on your own computer, so a 3-minute demo and a 3-hour session cost the same: nothing.</p>

        <div class="meter reveal" id="meter">
          <label for="minutes">
            <span>Audio you transcribe per month</span>
            <output id="minutes-out" class="mono">120 min</output>
          </label>
          <input id="minutes" type="range" min="5" max="1200" step="5" value="120" />
          <div class="meter-cols">
            <div class="meter-card">
              <span class="meter-k">Credit-based cloud plugin</span>
              <b id="cloud-credits">18,000</b>
              <span class="meter-unit">credits per month</span>
              <div class="bar"><i id="cloud-bar"></i></div>
              <span class="meter-sub" id="cloud-sub">3.6× the free plan's 5,000 monthly credits</span>
            </div>
            <div class="meter-card ours">
              <span class="meter-k">Audio2MIDI</span>
              <b>0</b>
              <span class="meter-unit">credits, ever</span>
              <div class="bar"><i style="width:0"></i></div>
              <span class="meter-sub">Runs on your computer. Bring your own CPU or GPU.</span>
            </div>
          </div>
          <p class="meter-src">Cloud figures use Mirelo's published rate of 2.5 credits per audio second and its free plan of 5,000 credits per month, <a href="https://mirelo.ai/blog/audio-to-midi-vst-plugin">checked November 9, 2026</a>. Paid plans not shown. Rates may change.</p>
        </div>

        <div class="local-grid">
          <article class="reveal">
            <h3>No credits, no quota</h3>
            <p>No balance to top up and no monthly cap. Transcribe as long as your machine has power and disk.</p>
          </article>
          <article class="reveal">
            <h3>Audio stays home</h3>
            <p>The plugin talks to the engine on 127.0.0.1. Unreleased tracks never leave your computer.</p>
          </article>
          <article class="reveal">
            <h3>Works offline</h3>
            <p>After the first download of the engine and weights, transcription needs no internet connection.</p>
          </article>
          <article class="reveal">
            <h3>No account to keep</h3>
            <p>No Audio2MIDI login. A free Hugging Face account unlocks the model weights once.</p>
          </article>
        </div>

        <div class="flow reveal" aria-label="Architecture: your DAW, the Audio2MIDI plugin and the MuScriptor engine all run on your computer">
          <div class="flow-box"><span class="mono">01</span>Your DAW</div>
          <div class="flow-line"><span class="mono">audio</span></div>
          <div class="flow-box">Audio2MIDI plugin<small>JUCE · C++</small></div>
          <div class="flow-line"><span class="mono">http</span></div>
          <div class="flow-box accent">MuScriptor engine<small class="mono">127.0.0.1:8722</small></div>
          <div class="flow-machine mono">all on your computer</div>
        </div>

        <div class="models">
          <article class="reveal"><span class="mono">small</span><h3>Fastest</h3><p>About 0.4 GB extra download. Good for quick sketches.</p></article>
          <article class="reveal active"><span class="mono">medium · default</span><h3>Balanced</h3><p>About 2 GB with PyTorch on the first run.</p></article>
          <article class="reveal"><span class="mono">large</span><h3>Most accurate</h3><p>About 5.5 GB. Slower, and needs more memory.</p></article>
        </div>
      </div>
    </section>

    <section class="section" id="features">
      <div class="wrap">
        <span class="eyebrow reveal">Built for the DAW</span>
        <h2 class="reveal">Everything you need between<br />the bounce and the edit.</h2>
        <div class="features">
          {features.map((f, i) => (
            <article class={`feature reveal f${i}`}>
              <span class="tag mono">{f.tag}</span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section compare-sec" id="compare">
      <div class="wrap">
        <span class="eyebrow reveal">Compare</span>
        <h2 class="reveal">Audio2MIDI vs. Mirelo.</h2>
        <p class="lead reveal">Mirelo makes a great cloud plugin, and co-released the open MuScriptor model that Audio2MIDI runs. The difference is where the work happens and who pays for it.</p>
        <div class="table-wrap reveal">
          <table>
            <thead>
              <tr><th scope="col"><span class="sr">Aspect</span></th><th scope="col" class="us">Audio2MIDI</th><th scope="col">Mirelo Audio-to-MIDI plugin</th></tr>
            </thead>
            <tbody>
              {rows.map(([k, a, b]) => (
                <tr><th scope="row">{k}</th><td class="us">{a}</td><td>{b}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="src reveal">
          Checked November 9, 2026 against Mirelo's <a href="https://mirelo.ai/blog/audio-to-midi-vst-plugin">plugin announcement and FAQ</a>, <a href="https://mirelo.ai/models/audio-to-midi">model overview</a> and the <a href="https://huggingface.co/MuScriptor/muscriptor-medium">MuScriptor model card</a>. Free does not mean unrestricted: the MuScriptor weights are CC BY-NC 4.0 (non-commercial), and we don't claim the accuracy of Mirelo's production model.
        </p>
      </div>
    </section>

    <section class="section" id="install">
      <div class="wrap install">
        <div>
          <span class="eyebrow reveal">Install</span>
          <h2 class="reveal">Up and running<br />in a few minutes.</h2>
          <ol class="install-steps">
            <li class="reveal"><b>Install uv.</b> The plugin uses it to set up an isolated Python 3.12 environment. <a href="https://docs.astral.sh/uv/getting-started/installation/">uv install guide</a></li>
            <li class="reveal"><b>Unlock the model.</b> Accept the licence on <a href="https://huggingface.co/MuScriptor/muscriptor-medium">MuScriptor on Hugging Face</a>, then sign in once:<code class="cmd">uvx hf auth login</code></li>
            <li class="reveal"><b>Install the plugin.</b> Open the <code>.pkg</code>. It is not notarized, so allow it once under System Settings → Privacy & Security → Open Anyway. No admin password needed.</li>
            <li class="reveal"><b>Rescan your DAW</b> and insert Audio2MIDI on an audio track. The first transcription downloads the engine and weights.</li>
          </ol>
        </div>
        <aside class="req reveal">
          <h3>Requirements</h3>
          <ul>
            <li><span>System</span>macOS 11 or later, Apple Silicon or Intel</li>
            <li><span>Formats</span>VST3, AU, Standalone</li>
            <li><span>Disk</span>About 2 GB for PyTorch and the medium model</li>
            <li><span>Tools</span>uv and a free Hugging Face account</li>
            <li><span>Windows</span>Builds from source, untested</li>
          </ul>
          <a class="btn" href={download}><Fragment set:html={arrow} />Download Audio2MIDI</a>
          <a class="req-link" href={`${repo}/releases/latest`}>All release files and checksums</a>
        </aside>
      </div>
    </section>

    <section class="section faq-sec" id="faq">
      <div class="wrap faq">
        <div>
          <span class="eyebrow reveal">FAQ</span>
          <h2 class="reveal">Questions,<br />answered.</h2>
        </div>
        <div class="faq-list">
          {faqs.map((f) => (
            <details class="reveal">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final">
      <div class="wrap final-inner reveal">
        <h2>Stop paying per second.<br /><span class="grad-text">Start transcribing.</span></h2>
        <p>Free, local and open source. Your songs, your machine, your MIDI.</p>
        <div class="cta">
          <a class="btn light" href={download}><Fragment set:html={arrow} />Download for macOS</a>
          <a class="btn ghost-dark" href={repo}><Fragment set:html={github} />Star on GitHub</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-inner">
      <a class="brand" href="/"><img src="/logo.png" alt="" width="28" height="28" /><span>awesome<b>AE</b></span></a>
      <p>Audio2MIDI is open source under <a href={`${repo}/blob/main/LICENSE`}>AGPL-3.0</a>. Transcription by <a href="https://github.com/muscriptor/muscriptor">MuScriptor</a> by Kyutai and Mirelo, whose weights are CC BY-NC 4.0. This project is not affiliated with Kyutai or Mirelo. No cookies, no tracking.</p>
      <nav aria-label="Footer">
        <a href={repo}>GitHub</a>
        <a href={`${repo}/releases`}>Releases</a>
        <a href={`${repo}/issues`}>Issues</a>
      </nav>
    </div>
  </footer>

  <script type="application/json" id="notes-data" set:html={JSON.stringify(notes)} />
</Layout>

<script>
  import { initPage } from "../scripts/page";
  initPage();
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }
  .nav.scrolled {
    background: rgb(247 247 251 / 0.82);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font: 600 1.2rem var(--font-display);
    letter-spacing: -0.03em;
  }
  .brand img {
    border-radius: 9px;
  }
  .brand b {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .nav nav {
    display: flex;
    gap: 34px;
  }
  .nav nav a,
  .foot nav a {
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
    color: #2b2d45;
  }
  .nav nav a:hover {
    color: var(--blue);
  }
  .nav-cta {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .icon-link {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }
  .icon-link:hover {
    background: #eceef7;
  }
  .icon-link :global(svg) {
    width: 22px;
    height: 22px;
  }
  .btn.small {
    min-height: 40px;
    padding: 0 20px;
    font-size: 0.92rem;
  }

  .hero {
    position: relative;
    padding-top: clamp(40px, 7vw, 90px);
    padding-bottom: 40px;
    isolation: isolate;
  }
  .hero-glow {
    position: absolute;
    inset: -120px 0 auto;
    height: 760px;
    z-index: -1;
    background:
      radial-gradient(40% 50% at 22% 30%, rgb(34 195 238 / 0.2), transparent 70%),
      radial-gradient(38% 46% at 80% 22%, rgb(168 85 247 / 0.18), transparent 70%),
      radial-gradient(50% 40% at 50% 70%, rgb(91 124 255 / 0.12), transparent 70%);
    pointer-events: none;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 26px;
  }
  .hero .lead {
    max-width: 700px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .fine {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .studio {
    margin-top: clamp(48px, 7vw, 80px);
    border-radius: 26px;
    background: var(--night);
    color: #e8e9ff;
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.06) inset,
      0 50px 120px -40px rgb(40 40 120 / 0.55),
      0 30px 60px -30px rgb(10 10 40 / 0.5);
    overflow: hidden;
  }
  .studio-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px;
    border-bottom: 1px solid var(--night-line);
    font-size: 0.85rem;
  }
  .lights {
    display: flex;
    gap: 7px;
  }
  .lights i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #2b2e55;
  }
  .studio-title {
    font-weight: 600;
  }
  .engine {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--night-muted);
  }
  .engine .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #34d399;
    box-shadow: 0 0 10px #34d399;
  }
  .studio-body {
    display: grid;
    grid-template-columns: 1fr 280px;
  }
  .roll-wrap {
    padding: 18px;
    display: grid;
    gap: 12px;
    min-width: 0;
  }
  .roll-wrap canvas {
    width: 100%;
    border-radius: 12px;
  }
  #roll {
    height: 300px;
    background: var(--night-2);
  }
